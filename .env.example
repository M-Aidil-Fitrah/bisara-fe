# Backend API URL:
# - Lokal: http://localhost:4000/api
# - Staging: https://api-staging-bisara.kitakarsa.com/api
# - Production: https://api-bisara.kitakarsa.com/api
VITE_API_URL=http://localhost:4000/api

# WebSocket URL:
# - Lokal: ws://localhost:4000
# - Staging: wss://api-staging-bisara.kitakarsa.com
# - Production: wss://api-bisara.kitakarsa.com
VITE_WS_URL=ws://localhost:4000

# Custom PeerJS Signaling Server (Coolify):
# - Host: peer.kitakarsa.cloud
VITE_PEER_HOST=peer.kitakarsa.cloud
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true

# TURN relay wajib untuk media konsultasi lintas jaringan. Jangan commit kredensial asli.
VITE_TURN_URL=turns:turn.example.invalid:5349
VITE_TURN_USERNAME=CHANGE_ME
VITE_TURN_CREDENTIAL=CHANGE_ME
